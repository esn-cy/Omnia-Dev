#!/usr/bin/env php
<?php

// Check autoload locations
$autoloadLocations = [
    __DIR__ . '/../vendor/autoload.php',
    __DIR__ . '/../../../autoload.php',
];

$autoloaderFound = false;
foreach ($autoloadLocations as $autoload) {
    if (file_exists($autoload)) {
        require_once $autoload;
        $autoloaderFound = true;
        break;
    }
}

if (!$autoloaderFound) {
    fwrite(STDERR, "Error: vendor/autoload.php not found. Please run 'composer install' first.\n");
    exit(1);
}

use Drupal\omnia_dev\Application;

$application = new Application();
$application->run();
